# ============================================
# NextBot — Environment Configuration
# Copy this file to .env and fill in the values
# ============================================

# --- Required ---

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=

# --- Database ---
DATABASE_PATH=sessions/smart_bot.db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=smart_bot_knowledge

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Wildberries (optional) ---
WB_API_KEY=
WB_CHECK_INTERVAL_SECONDS=300
WB_CHAT_POLLING_INTERVAL_SECONDS=15
WB_CHAT_DEBUG=false

# --- Ozon (optional) ---
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_CHECK_INTERVAL_SECONDS=300
OZON_CHAT_POLLING_INTERVAL_SECONDS=60

# --- Telegram / Telethon (optional) ---
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_PHONE=
TELEGRAM_PASSWORD=
TELETHON_SESSION_NAME=sessions/user_session
TELEGRAM_MESSAGE_DELAY_SECONDS=2

# --- Langfuse analytics (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Multi-tenancy (optional, JSON array) ---
# EXTRA_CLIENTS_JSON=[{"id":"client2","name":"Client 2","wb_api_key":"...","qdrant_collection":"kb_client2"}]

# --- LLM tuning (optional) ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
ACCESS_TOKEN_EXPIRE_MINUTES=10080
